# Copy this file to .env (same folder). .env is git-ignored, so keys are never committed.
# Only the names below are read from .env; shell variables take priority.

# Google Gemini key for Nour (free tier works). Without it Nour uses offline answers.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# 1 = unlock every feature without payment (for judges and demos).
# DEMO_MODE=1

# manual (default): admins grant Pro or hand out activation codes.
# mock: a test checkout with no real money, for demos.
# PAYMENT_PROVIDER=mock

# Comma-separated emails that become administrators when they sign in.
# ADMIN_EMAILS=you@example.com

# 1 = always mark the session cookie Secure (set this behind HTTPS).
# COOKIE_SECURE=1

# Secret for signing mock webhooks. Random per run if empty.
# MOCK_WEBHOOK_SECRET=
